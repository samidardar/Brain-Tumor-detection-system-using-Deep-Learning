# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual Environment
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data (large files - download separately)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Model checkpoints (large - use Git LFS or download separately)
models/*.pth
models/*.pt
models/*.onnx
!models/.gitkeep

# Node modules (frontend)
frontend/node_modules/

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env
*.env

# Jupyter
.ipynb_checkpoints/

# Logs (keep training logs for documentation)
backend.log

# Debug files
debug_*.py
test_debug.*
synthetic_eye.*

# MLflow / Wandb
mlruns/
wandb/

# Keep outputs (training curves, evaluation plots) for the report
# outputs/ -- NOT ignored, included for documentation
